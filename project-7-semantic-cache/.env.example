OPENAI_API_KEY=
REDIS_URL=redis://localhost:6379

# Optional providers (Phase 2)
ANTHROPIC_API_KEY=
OLLAMA_BASE_URL=http://localhost:11434

# Cache tuning
CACHE_SIMILARITY_THRESHOLD=0.95
CACHE_THRESHOLD_CLASSIFICATION=0.90
CACHE_THRESHOLD_DEFAULT=0.95
CACHE_THRESHOLD_CREATIVE=0.98
CACHE_SKIP_CREATIVE=false
CACHE_DEFAULT_TTL_SECONDS=86400
CACHE_TTL_STABLE_SECONDS=86400
CACHE_TTL_DEFAULT_SECONDS=86400
CACHE_TTL_TIME_SENSITIVE_SECONDS=3600
